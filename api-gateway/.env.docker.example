# .env.docker
# ==============================================================================
# SPRING BOOT CORE
# ==============================================================================
# For Local: local,graylog-enabled | For Docker: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker,graylog-enabled
SERVER_PORT=8080

# ==============================================================================
# GATEWAY NETWORK & TIMEOUTS (Optimized for High Scale/Large Files)
# ==============================================================================
SPRING_CODEC_MAX_IN_MEMORY_SIZE=500MB
GATEWAY_HTTP_KEEP_ALIVE=3600s
GATEWAY_HTTP_CONNECT_TIMEOUT=60000
GATEWAY_HTTP_RESPONSE_TIMEOUT=300s
GATEWAY_POOL_MAX_CONNECTIONS=5000
CIRCUIT_BREAKER_TIMEOUT=305s

# ==============================================================================
# SERVICE DISCOVERY (Routing Hostnames)
# ==============================================================================
# Local: localhost | Docker: service-container-name
USER_SERVICE=user-service:28001
RESTAURANT_SERVICE=restaurant-service:28002
MENU_SERVICE=menu-service:28003
BOOKING_SERVICE=booking-service:28004
ORDER_SERVICE=order-service:28005
PAYMENT_SERVICE=payment-service:28006
POS_SERVICE=pos-service:28007
REVIEW_SERVICE=review-service:28008
ANALYTICS_SERVICE=analytics-service:28009
NOTIFICATION_SERVICE=notification-service:28010

# ==============================================================================
# GRPC SERVICE DISCOVERY
# ==============================================================================
# Local: localhost | Docker: service-name (e.g. user-service)
USER_GRPC_SERVICE=user-service:29001
RESTAURANT_GRPC_SERVICE=restaurant-service:29002
MENU_GRPC_SERVICE=menu-service:29003
BOOKING_GRPC_SERVICE=booking-service:29004
ORDER_GRPC_SERVICE=order-service:29005
PAYMENT_GRPC_SERVICE=payment-service:29006
POS_GRPC_SERVICE=pos-service:29007
REVIEW_GRPC_SERVICE=review-service:29008
ANALYTICS_GRPC_SERVICE=analytics-service:29009
NOTIFICATION_GRPC_SERVICE=notification-service:29010
GRPC_CLIENT_DEADLINE_SECONDS=60

# ==============================================================================
# REDIS (Distributed Locks & HA) - ENABLED
# ==============================================================================
# Must be "redis" for Redisson config to load (see @ConditionalOnProperty)
SPRING_CACHE_TYPE=redis
REDIS_ENABLED=true

# Standalone (local / Docker)
SPRING_DATA_REDIS_HOST=tuttime-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=password
SPRING_DATA_REDIS_TIMEOUT=8000ms
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=20
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=10
SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=2
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.data.redis.RedisAutoConfiguration,org.springframework.boot.autoconfigure.data.redis.RedisReactiveAutoConfiguration,org.springframework.boot.autoconfigure.data.redis.RedisRepositoriesAutoConfiguration,org.springframework.boot.actuate.autoconfigure.data.redis.RedisHealthContributorAutoConfiguration,org.springframework.boot.actuate.autoconfigure.data.redis.RedisReactiveHealthContributorAutoConfiguration

# ==============================================================================
# MESSAGING (Kafka)
# ==============================================================================
KAFKA_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=tuttime-kafka:9093
SPRING_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-256
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG='org.apache.kafka.common.security.scram.ScramLoginModule required username="gateway-kafka-user" password="***REMOVED***";'

# ==============================================================================
# APP CORS ALLOWED ORIGINS
# ==============================================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:18080,https://tuttime-web.vercel.app,http://localhost:5173,http://localhost:8081

# ==============================================================================
# SECURITY (JWT & CLUSTER INTERNAL SECRET)
# ==============================================================================
JWT_SECRET=***REMOVED***
JWT_EXPIRATION=86400000 # 24 Hours in milliseconds
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-frontend
CLUSTER_INTERNAL_SECRET=***REMOVED***

# Rate Limiting Capacities
RATE_LIMIT_SIGNIN_CAPACITY=5
RATE_LIMIT_SIGNUP_CAPACITY=3
RATE_LIMIT_SIGNUP_SEND_SMS_CAPACITY=3
RATE_LIMIT_PASSWORD_FORGOT_CAPACITY=3

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Local: http://localhost:9411/api/v2/spans | Docker: http://zipkin:9411/api/v2/spans
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans
LOG_LEVEL=INFO

# Graylog
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=api-gateway
GRAYLOG_FACILITY=api-gateway
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# ==============================================================================
# SECURITY & ANTI-FRAUD
# ==============================================================================
BRUTEFORCE_WARNING_THRESHOLD=3
BRUTEFORCE_IP_BLOCK_THRESHOLD=5
BRUTEFORCE_PHONE_BLOCK_THRESHOLD=10
BRUTEFORCE_PERMANENT_BLOCK_THRESHOLD=15
BRUTEFORCE_IP_BLOCK_DURATION_MINUTES=15
BRUTEFORCE_PHONE_BLOCK_DURATION_MINUTES=60

ANTIFRAUD_MAX_DEVICES_PER_USER=3
ANTIFRAUD_MULTI_ACCOUNT_IP_THRESHOLD=3

# ==============================================================================
# CLOUD & INFRASTRUCTURE
# ==============================================================================
SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED=false
SPRING_CLOUD_KUBERNETES_CONFIG_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_NAMESPACES=tuttime
