# .env.example
# ==============================================================================
# SPRING BOOT CORE
# ==============================================================================
# For Local: local,graylog-enabled | For Docker: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=local,graylog-enabled
SERVER_PORT=8080

# ==============================================================================
# GATEWAY NETWORK & TIMEOUTS (Optimized for High Scale/Large Files)
# ==============================================================================
SPRING_CODEC_MAX_IN_MEMORY_SIZE=500MB
GATEWAY_HTTP_KEEP_ALIVE=3600s
GATEWAY_HTTP_CONNECT_TIMEOUT=60000
GATEWAY_HTTP_RESPONSE_TIMEOUT=300s
GATEWAY_POOL_MAX_CONNECTIONS=5000
CIRCUIT_BREAKER_TIMEOUT=305s

# ==============================================================================
# SERVICE DISCOVERY (Routing Hostnames)
# ==============================================================================
# Local: localhost | Docker: service-container-name
USER_SERVICE=localhost:28001
RESTAURANT_SERVICE=localhost:28002
MENU_SERVICE=localhost:28003
BOOKING_SERVICE=localhost:28004
ORDER_SERVICE=localhost:28005
PAYMENT_SERVICE=localhost:28006
POS_SERVICE=localhost:28007
REVIEW_SERVICE=localhost:28008
ANALYTICS_SERVICE=localhost:28009
NOTIFICATION_SERVICE=localhost:28010

# ==============================================================================
# GRPC SERVICE DISCOVERY
# ==============================================================================
# Local: localhost | Docker: service-name (e.g. menu-service)
USER_GRPC_SERVICE=localhost:29001
RESTAURANT_GRPC_SERVICE=localhost:29002
MENU_GRPC_SERVICE=localhost:29003
BOOKING_GRPC_SERVICE=localhost:29004
ORDER_GRPC_SERVICE=localhost:29005
PAYMENT_GRPC_SERVICE=localhost:29006
POS_GRPC_SERVICE=localhost:29007
REVIEW_GRPC_SERVICE=localhost:29008
ANALYTICS_GRPC_SERVICE=localhost:29009
NOTIFICATION_GRPC_SERVICE=localhost:29010

# ==============================================================================
# CACHE & DATA (Redis - Token Blacklist)
# ==============================================================================
SPRING_CACHE_TYPE=none
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=password
SPRING_DATA_REDIS_TIMEOUT=8000ms
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=20
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=10
SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=2

# ==============================================================================
# MESSAGING (Kafka)
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SPRING_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=

# ==============================================================================
# APP CORS ALLOWED ORIGINS
# ==============================================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:18080,https://tuttime-web.vercel.app,http://localhost:5173,http://localhost:8081

# ==============================================================================
# SECURITY (JWT & Rate Limiting)
# ==============================================================================
JWT_SECRET=***REMOVED***
JWT_EXPIRATION=86400000
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-frontend

# Rate Limiting Capacities
RATE_LIMIT_SIGNIN_CAPACITY=5
RATE_LIMIT_SIGNUP_CAPACITY=3
RATE_LIMIT_SIGNUP_SEND_SMS_CAPACITY=3
RATE_LIMIT_PASSWORD_FORGOT_CAPACITY=3

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Local: http://localhost:9411/api/v2/spans | Docker: http://zipkin:9411/api/v2/spans
ZIPKIN_URL=http://localhost:9411/api/v2/spans
LOG_LEVEL=INFO

# Graylog
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=api-gateway
GRAYLOG_FACILITY=api-gateway
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# ==============================================================================
# CLOUD & INFRASTRUCTURE
# ==============================================================================
SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED=false
SPRING_CLOUD_KUBERNETES_CONFIG_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_NAMESPACES=tuttime
