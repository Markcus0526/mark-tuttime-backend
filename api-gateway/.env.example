# ============================================================================
# API Gateway - Environment Variables Example
# Copy this file to .env.docker and update with your actual values
# ============================================================================

# Spring Profiles
# For Docker: docker
# To enable Graylog logging: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker

# Redis Configuration
REDIS_HOST=apart-token-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Zipkin Tracing Configuration
ZIPKIN_URL=http://apart-token-zipkin:9411/api/v2/spans

# Service Name Variables (used for route URIs)
# Set to Docker service names for Docker environment
USER_SERVICE=user-service
TOKEN_SERVICE=***REMOVED***
MINING_SERVICE=mining-service
STAKING_SERVICE=staking-service
REWARDS_SERVICE=rewards-service
CONTENT_SERVICE=content-service
CONVERSION_SERVICE=conversion-service
NOTIFICATION_SERVICE=notification-service
BOOKING_INTEGRATION_SERVICE=booking-integration-service

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=apart-token-backend
JWT_AUDIENCE=apart-token-mobile-app

# Logging Configuration
LOG_LEVEL=INFO

# Graylog Configuration (optional - only used if graylog-enabled profile is active)
GRAYLOG_HOST=90.156.157.241
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=api-gateway
GRAYLOG_FACILITY=api-gateway

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://app.apart.com,http://localhost:3000,http://localhost:8080