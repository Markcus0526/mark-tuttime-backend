# ============================================================================
# API Gateway - Environment Variables Example
# Copy this file to .env.docker and update with your actual values
# ============================================================================

# Spring Profiles
# For Docker: docker
# To enable Graylog logging: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=local

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Zipkin Tracing Configuration
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans

# Service Name Variables (used for route URIs)
# Set to Docker service names for Docker environment
USER_SERVICE=localhost
RESTAURANT_SERVICE=localhost
ADMIN_SERVICE=localhost
BOOKING_SERVICE=localhost
MENU_SERVICE=localhost
ORDER_SERVICE=localhost
PAYMENT_SERVICE=localhost
ANALYTICS_SERVICE=localhost
REVIEW_SERVICE=localhost
INTEGRATION_SERVICE=localhost

# JWT Security Configuration
JWT_SECRET=***REMOVED***
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-mobile-app

# Logging Configuration
LOG_LEVEL=INFO

# Graylog Configuration (optional - only used if graylog-enabled profile is active)
GRAYLOG_HOST=90.156.157.241
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=api-gateway
GRAYLOG_FACILITY=api-gateway

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://app.tuttime.com,http://localhost:3000,http://localhost:8080

RATE_LIMIT_SIGNUP_SENDSMS_CAPACITY=3
RATE_LIMIT_SIGNUP_SENDSMS_PERIOD=1
RATE_LIMIT_SIGNUP_VERIFYSMS_CAPACITY=10
RATE_LIMIT_SIGNUP_VERIFYSMS_PERIOD=1
RATE_LIMIT_PASSWORD_VERIFYSMS_CAPACITY=10
RATE_LIMIT_PASSWORD_VERIFYSMS_PERIOD=1