<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="HOSTNAME" value="api-gateway"/>
    <contextName>api-gateway</contextName>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- CONSOLE APPENDER -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) : %highlight(%msg)
                %n%highlight(%throwable)
            </pattern>
        </encoder>
    </appender>

    <springProperty scope="context" name="graylogHost" source="graylog.host" defaultValue="173.249.29.61"/>
    <springProperty scope="context" name="graylogPort" source="graylog.port" defaultValue="12203"/>

    <springProfile name="graylog-enabled">
        <appender name="GELF_UDP" class="de.siegmar.logbackgelf.GelfUdpAppender">
            <graylogHost>${graylogHost}</graylogHost>
            <graylogPort>${graylogPort}</graylogPort>
            <useCompression>true</useCompression>
            <originHost>api-gateway</originHost>
            <facility>api-gateway</facility>

            <!-- ADD YOUR CUSTOM FILTER TO SUPPRESS HEALTH CHECKS -->
            <filter class="com.tuttime.gateway.filter.HealthCheckLogFilter"/>

            <encoder class="de.siegmar.logbackgelf.GelfEncoder">
                <!-- Remove the duplicate originHost line below -->
                <!-- <originHost>api-gateway</originHost>   ← DELETE THIS -->
                <includeRawMessage>false</includeRawMessage>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
            </encoder>
        </appender>

        <appender name="ASYNC_GELF_UDP" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="GELF_UDP"/>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="graylog-enabled">
            <appender-ref ref="ASYNC_GELF_UDP"/>
        </springProfile>
    </root>
</configuration>