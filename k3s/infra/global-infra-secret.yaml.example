apiVersion: v1
kind: Secret
metadata:
  name: global-infra-secrets
  namespace: tuttime
type: Opaque
stringData:
  # 🔐 Redis Shared Infrastructure Password
  INFRA_REDIS_PASSWORD: "YOUR_INFRA_REDIS_PASSWORD"

  # 🔐 Graylog Central Log Engine Hashes
  GRAYLOG_PASSWORD_SECRET: "YOUR_GRAYLOG_PASSWORD_SECRET"
  GRAYLOG_ROOT_PASSWORD_SHA2: "YOUR_GRAYLOG_ROOT_PASSWORD_SHA2"

  # 🔐 Kafka Password Account Matrix Map
  KAFKA_PASSWORDS_LIST: "***REMOVED***"
