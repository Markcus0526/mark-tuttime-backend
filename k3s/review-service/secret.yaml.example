apiVersion: v1
kind: Secret
metadata:
  name: review-service-secrets
  namespace: tuttime
type: Opaque
data:
  DATABASE_USERNAME: "YOUR_PRODUCTION_DB_USER"
  DATABASE_PASSWORD: "YOUR_PRODUCTION_DB_PASSWORD"
  SPRING_DATA_REDIS_PASSWORD: "YOUR_PRODUCTION_REDIS_PASSWORD"

# Use stringData to type out the Kafka JAAS credential in plain, readable text:
stringData:
  SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.scram.ScramLoginModule required username="YOUR_USER" password="YOUR_PASSWORD";'