<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback Configuration Template for Structured Logging with Correlation ID
    
    This template provides structured logging configuration that includes:
    - Correlation ID from MDC context
    - JSON structured output (optional, requires logstash-logback-encoder dependency)
    - Console and file appenders
    - Sensitive data filtering
    
    To use this template:
    1. Copy this file to your service's src/main/resources/ as logback-spring.xml
    2. Customize appender names and file paths as needed
    3. Add logstash-logback-encoder dependency for JSON output (optional):
       
       <dependency>
           <groupId>net.logstash.logback</groupId>
           <artifactId>logstash-logback-encoder</artifactId>
           <version>7.4</version>
       </dependency>
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Property definitions -->
    <property name="LOG_FILE" value="${LOG_FILE:-logs/application.log}"/>
    <property name="LOG_FILE_ERROR" value="${LOG_FILE_ERROR:-logs/error.log}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-}] %logger{36} - %msg%n"/>
    <property name="LOG_PATTERN_JSON" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    
    <!-- Console Appender with Structured Pattern (includes correlation ID) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    
    <!-- Optional: JSON Console Appender (requires logstash-logback-encoder dependency) -->
    <!--
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <version/>
                <logLevel/>
                <message/>
                <mdc/>
                <stackTrace/>
                <pattern>
                    <pattern>
                        {
                            "correlationId": "%mdc{correlationId}",
                            "traceId": "%mdc{traceId}",
                            "thread": "%thread",
                            "logger": "%logger",
                            "class": "%class",
                            "method": "%method",
                            "line": "%line"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>
    -->
    
    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Error File Appender (only ERROR level and above) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE_ERROR}</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_ERROR}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>90</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Async Appender for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE"/>
    </appender>
    
    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>
    
    <!-- Logger for application packages -->
    <logger name="com.tuttime" level="${LOG_LEVEL_APARTTOKEN:-DEBUG}"/>
    
    <!-- Logger for Spring Framework (reduce verbosity) -->
    <logger name="org.springframework" level="${LOG_LEVEL_SPRING:-INFO}"/>
    
    <!-- Logger for Hibernate/SQL (reduce verbosity) -->
    <logger name="org.hibernate" level="${LOG_LEVEL_HIBERNATE:-WARN}"/>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_HIBERNATE_SQL:-DEBUG}"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="${LOG_LEVEL_HIBERNATE_BINDER:-TRACE}"/>
    
    <!-- Root logger -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <!-- Uncomment to use JSON console appender instead -->
        <!-- <appender-ref ref="JSON_CONSOLE"/> -->
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>
    
    <!-- Spring Profile-specific configurations -->
    <springProfile name="local,dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>
    
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>
</configuration>

