{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingEvent",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "integer"
    },
    "user_id": {
      "type": "integer"
    },
    "property_id": {
      "type": "integer"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "confirmed": {
      "type": "boolean"
    },
    "non_refundable": {
      "type": "boolean"
    },
    "booking_amount": {
      "type": "number"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CREATED",
        "CONFIRMED",
        "CANCELLED"
      ]
    },
    "timestamp": {
      "type": "integer"
    }
  },
  "required": [
    "booking_id",
    "user_id",
    "event_type"
  ]
}

