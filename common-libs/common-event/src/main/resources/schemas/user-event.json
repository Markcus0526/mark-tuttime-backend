{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "USER_CREATED",
        "USER_UPDATED",
        "USER_VERIFIED",
        "USER_DEACTIVATED",
        "USER_BLOCKED",
        "USER_UNBLOCKED",
        "KYC_COMPLETED",
        "KYC_REJECTED",
        "EMAIL_VERIFIED",
        "PASSWORD_CHANGED"
      ]
    },
    "user_id": {
      "type": "integer"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "username": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean"
    },
    "kyc_completed": {
      "type": "boolean"
    },
    "is_active": {
      "type": "boolean"
    },
    "is_blocked": {
      "type": "boolean"
    },
    "status_level": {
      "type": "string",
      "enum": [
        "BRONZE",
        "GOLD",
        "PLATINUM",
        "DIAMOND"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "user_id",
    "timestamp"
  ]
}

