# .env.docker
# ==============================================================================
# SPRING BOOT CORE
# ==============================================================================
# For Local: local,graylog-enabled | For Docker: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker,graylog-enabled
SERVER_PORT=28001
GRPC_PORT=29001

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

POSTGRES_DB=user_service_db

# Local: localhost:5401 | Docker: db:5432
DATABASE_URL=jdbc:postgresql://user-service-db:5432/user_service_db?currentSchema=user_service&stringtype=unspecified&prepareThreshold=0&TimeZone=UTC

# Connection Pool
DB_POOL_MAX_SIZE=100
DB_POOL_MIN_IDLE=20
DB_REPLICA_POOL_MAX_SIZE=50
DB_REPLICA_POOL_MIN_IDLE=10

# ==============================================================================
# SECURITY (CLUSTER INTERNAL SECRET)
# ==============================================================================
CLUSTER_INTERNAL_SECRET=***REMOVED***

# ==============================================================================
# REDIS (Distributed Locks & HA) - ENABLED
# ==============================================================================
# Must be "redis" for Redisson config to load (see @ConditionalOnProperty)
SPRING_CACHE_TYPE=redis
REDIS_ENABLED=true

# Standalone (local / Docker)
SPRING_DATA_REDIS_HOST=tuttime-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=password
SPRING_DATA_REDIS_TIMEOUT=8000ms
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=20
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=10
SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=2

# ==============================================================================
# MESSAGING (Kafka)
# ==============================================================================
KAFKA_ENABLED=true
# Local: localhost:29092 | Docker: tuttime-kafka:9093
SPRING_KAFKA_BOOTSTRAP_SERVERS=tuttime-kafka:9093
SPRING_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-256
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG='org.apache.kafka.common.security.scram.ScramLoginModule required username="user-kafka-user" password="***REMOVED***";'

# ==============================================================================
# SECURITY (JWT)
# ==============================================================================
JWT_SECRET=***REMOVED***
JWT_EXPIRATION=86400000
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-frontend

# ==============================================================================
# STORAGE & MEDIA
# ==============================================================================
MEDIA_STORAGE_TYPE=local
MEDIA_MAX_SIZE=5242880
MEDIA_MAX_DIMENSION=1024
MEDIA_QUALITY=0.85

# S3 Settings
S3_ENDPOINT=https://selcloud.ru
S3_REGION=ru-7
S3_BUCKET=tuttime-storage
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BASE_URL=
S3_PRESIGNED_URL_EXPIRATION_HOURS=24

# Local Settings
LOCAL_STORAGE_PATH=./uploads/medias
LOCAL_MEDIA_URL_PATH=/user-medias/

# ==============================================================================
# FILE UPLOADS (Multipart)
# ==============================================================================
SPRING_SERVLET_MULTIPART_ENABLED=true
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=2KB

# ==============================================================================
# GRPC SERVICE DISCOVERY
# ==============================================================================
# Local: localhost | Docker: service-name (e.g. restaurant-service)
USER_GRPC_SERVICE=user-service:29001
RESTAURANT_GRPC_SERVICE=restaurant-service:29002
MENU_GRPC_SERVICE=menu-service:29003
BOOKING_GRPC_SERVICE=booking-service:29004
ORDER_GRPC_SERVICE=order-service:29005
PAYMENT_GRPC_SERVICE=payment-service:29006
POS_GRPC_SERVICE=pos-service:29007
REVIEW_GRPC_SERVICE=review-service:29008
ANALYTICS_GRPC_SERVICE=analytics-service:29009
NOTIFICATION_GRPC_SERVICE=notification-service:29010
GRPC_CLIENT_DEADLINE_SECONDS=60

# ==============================================================================
# TIMEOUTS (Optimized for High Scale/Large Files)
# ==============================================================================
CIRCUIT_BREAKER_TIMEOUT=305s

# ==============================================================================
# SPRINGDOC SWAGGER
# ==============================================================================
SWAGGER_API_GATEWAY_URL=http://localhost:8080/user-docs

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Local: localhost:9411 | Docker: zipkin:9411
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans
LOG_LEVEL=INFO

# Graylog
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=user-service
GRAYLOG_FACILITY=user-service
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_INCLUDE_CALLER_DATA=false
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# ==============================================================================
# SECURITY & ANTI-FRAUD
# ==============================================================================
BRUTEFORCE_WARNING_THRESHOLD=3
BRUTEFORCE_IP_BLOCK_THRESHOLD=5
BRUTEFORCE_PHONE_BLOCK_THRESHOLD=10
BRUTEFORCE_PERMANENT_BLOCK_THRESHOLD=15
BRUTEFORCE_IP_BLOCK_DURATION_MINUTES=15
BRUTEFORCE_PHONE_BLOCK_DURATION_MINUTES=60

ANTIFRAUD_MAX_DEVICES_PER_USER=3
ANTIFRAUD_MULTI_ACCOUNT_IP_THRESHOLD=3

# ==============================================================================
# CLOUD & OTHER
# ==============================================================================
CONNECTION_POOL_MONITORING_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_NAMESPACES=tuttime
SPRING_CLOUD_KUBERNETES_CONFIG_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=your-apple-client-id
