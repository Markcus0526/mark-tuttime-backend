# ============================================================================
# User Service - Environment Variables Example
# Copy this file to .env.docker and update with your actual values
# ============================================================================

# Spring Profiles
# For Docker: docker
# To enable Graylog logging: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker

# Database Configuration
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here
POSTGRES_USER=postgres
POSTGRES_DB=user_service_db

# Database Connection Pool Configuration
DB_POOL_MAX_SIZE=100
DB_POOL_MIN_IDLE=20
DB_REPLICA_POOL_MAX_SIZE=50
DB_REPLICA_POOL_MIN_IDLE=10

# Redis Configuration
REDIS_HOST=tuttime-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Connection Pool Settings
REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=2


# Redis Sentinel Master Set Name (leave empty for Docker/Local)
SPRING_DATA_REDIS_SENTINEL_MASTER=

# Redis Sentinel Nodes (comma-separated list, leave empty for Docker/Local)
# Format: host1:port1,host2:port2,host3:port3
SPRING_DATA_REDIS_SENTINEL_NODES=

CACHE_TYPE=redis

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=tuttime-kafka:9093
KAFKA_ENABLED=true
KAFKA_CONSUMER_CONCURRENCY=2
KAFKA_DLQ_TOPIC=user-service-group.dlq
KAFKA_DLQ_MAX_RETRIES=3
KAFKA_DLQ_INITIAL_RETRY_DELAY_MS=1000
KAFKA_DLQ_RETRY_MULTIPLIER=2.0

# Zipkin Tracing Configuration
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans

# Service Name Variables (used for both REST and gRPC)
# Set to Docker service names for Docker environment
ANALYTICS_SERVICE=analytics-service
BOOKING_SERVICE=booking-service
POS_SERVICE=pos-service
MENU_SERVICE=menu-service
ORDER_SERVICE=order-service
PAYMENT_SERVICE=payment-service
RESTAURANT_SERVICE=restaurant-service
REVIEW_SERVICE=review-service
USER_SERVICE=user-service

# gRPC Configuration
GRPC_PORT=29191

# JWT Security Configuration
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-mobile-app

# Logging Configuration
LOG_LEVEL=INFO

# S3 Configuration
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=tuttime-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BASE_URL=
S3_PRESIGNED_URL_EXPIRATION_HOURS=24

# Image Storage Configuration
IMAGE_STORAGE_TYPE=s3
IMAGE_STORAGE_PATH=./uploads/images
IMAGE_MAX_SIZE=5242880
IMAGE_MAX_DIMENSION=1024
IMAGE_QUALITY=0.85

# Brute-Force Protection Configuration
BRUTEFORCE_WARNING_THRESHOLD=3
BRUTEFORCE_IP_BLOCK_THRESHOLD=5
BRUTEFORCE_PHONE_BLOCK_THRESHOLD=10
BRUTEFORCE_PERMANENT_BLOCK_THRESHOLD=15
BRUTEFORCE_IP_BLOCK_DURATION_MINUTES=15
BRUTEFORCE_PHONE_BLOCK_DURATION_MINUTES=60

# Anti-Fraud Configuration
ANTIFRAUD_MAX_DEVICES_PER_USER=3
ANTIFRAUD_MULTI_ACCOUNT_IP_THRESHOLD=3

# SMS Configuration
SMS_PROVIDER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=
SMS_CODE_LENGTH=4
SMS_CODE_EXPIRATION_MINUTES=5
SMS_SIGNUP_TOKEN_EXPIRATION_MINUTES=15
SMS_MAX_ATTEMPTS_PER_HOUR=3
SMS_TELEGRAM_API_URL=https://gatewayapi.telegram.org
SMS_TELEGRAM_API_TOKEN=
SMS_GREEN_API_URL=https://api3.greensms.ru
SMS_GREEN_JWT_TOKEN=
SMS_GREEN_FLASHCALL_ENDPOINT=/call/send
SMS_TWILIO_API_URL=https://api.twilio.com/2010-04-01
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=
SMS_FLASHCALL_API_URL=

# Graylog Configuration
GRAYLOG_HOST=173.249.29.61
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=user-service
GRAYLOG_FACILITY=user-service
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_INCLUDE_CALLER_DATA=false
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# Application Configuration
I18N_DIRECTORY=languages
MAP_USE_APPROXIMATE_COUNT=false
CONNECTION_POOL_MONITORING_ENABLED=false

# Email Verification - BoostX SMTP (Yandex)
# CTO settings: smtp.yandex.ru, port 465, SSL
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=support@tuttime.pro
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_AUTH=true
EMAIL_SMTP_SSL_ENABLE=true
EMAIL_SMTP_STARTTLS_ENABLE=false
EMAIL_SMTP_STARTTLS_REQUIRED=false
EMAIL_SMTP_CONNECTION_TIMEOUT=5000
EMAIL_SMTP_TIMEOUT=5000
EMAIL_SMTP_WRITE_TIMEOUT=5000

EMAIL_CODE_LENGTH=4
EMAIL_CODE_EXPIRATION_MINUTES=10
EMAIL_MAX_ATTEMPTS_PER_HOUR=3
EMAIL_SMTP_FROM_EMAIL=support@tuttime.pro
EMAIL_SMTP_FROM_NAME=Tuttime

FCM_CREDENTIALS_PATH=
