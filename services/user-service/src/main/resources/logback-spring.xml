<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="HOSTNAME" value="user-service" />
    <contextName>user-service</contextName>

    <include resource="org/springframework/boot/logging/logback/base.xml"/>   <!-- includes defaults.xml and console appender -->

    <!-- Console appender (already included in base.xml, but we customise pattern) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) : %highlight(%msg) %n%highlight(%throwable)</pattern>
        </encoder>
    </appender>

    <!-- Graylog GELF appender (only when 'graylog-enabled' profile is active) -->
    <springProfile name="graylog-enabled">
        <appender name="GELF_UDP" class="de.siegmar.logbackgelf.GelfUdpAppender">
            <graylogHost>${graylog.host:-localhost}</graylogHost>
            <graylogPort>${graylog.port:-12203}</graylogPort>
            <useCompression>true</useCompression>
            <originHost>user-service</originHost>
            <facility>user-service</facility>
            <encoder class="de.siegmar.logbackgelf.GelfEncoder">
                <originHost>user-service</originHost>
                <includeRawMessage>false</includeRawMessage>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
            </encoder>
        </appender>

        <appender name="ASYNC_GELF_UDP" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="GELF_UDP"/>
        </appender>
    </springProfile>

    <!-- Root logger: always use CONSOLE, and also ASYNC_GELF_UDP if profile is active -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- This top‑level <springProfile> adds the Graylog appender when the profile is active -->
    <springProfile name="graylog-enabled">
        <root level="INFO">
            <appender-ref ref="ASYNC_GELF_UDP"/>
        </root>
    </springProfile>
</configuration>