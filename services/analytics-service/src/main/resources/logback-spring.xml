<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Force the property into the context immediately -->
    <property name="HOSTNAME" value="analytics-service" />
    <contextName>analytics-service</contextName>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- CUSTOM CONSOLE APPENDER WITH RED ERRORS -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) : %highlight(%msg)%n%highlight(%throwable)
            </pattern>
        </encoder>
    </appender>

    <springProperty scope="context" name="graylogHost" source="graylog.host" defaultValue="173.249.29.61"/>
    <springProperty scope="context" name="graylogPort" source="graylog.port" defaultValue="12203"/>

    <springProfile name="graylog-enabled">
        <appender name="GELF_UDP" class="de.siegmar.logbackgelf.GelfUdpAppender">
            <graylogHost>${graylogHost}</graylogHost>
            <graylogPort>${graylogPort}</graylogPort>
            <useCompression>true</useCompression>
            <originHost>analytics-service</originHost>
            <facility>analytics-service</facility>

            <encoder class="de.siegmar.logbackgelf.GelfEncoder">
                <!-- HARDCODED: This prevents the UnknownHostException -->
                <originHost>analytics-service</originHost>
                <includeRawMessage>false</includeRawMessage>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
            </encoder>
        </appender>

        <appender name="ASYNC_GELF_UDP" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="GELF_UDP"/>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="graylog-enabled">
            <appender-ref ref="ASYNC_GELF_UDP"/>
        </springProfile>
    </root>
</configuration>
