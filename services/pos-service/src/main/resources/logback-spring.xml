<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Force the property into the context immediately -->
    <property name="HOSTNAME" value="pos-service"/>
    <contextName>pos-service</contextName>

    <include resource="org.springframework.boot/logging/logback/defaults.xml"/>

    <!-- CUSTOM CONSOLE APPENDER WITH RED ERRORS -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) : %highlight(%msg)
                %n%highlight(%throwable)
            </pattern>
        </encoder>
    </appender>

    <!-- No default values – they must be provided by Spring environment -->
    <springProperty scope="context" name="graylogHost" source="graylog.host"/>
    <springProperty scope="context" name="graylogPort" source="graylog.port"/>

    <springProfile name="graylog-enabled">
        <if condition='isDefined("graylogHost") &amp;&amp; isDefined("graylogPort")'>
            <then>
                <appender name="GELF_UDP" class="de.siegmar.logbackgelf.GelfUdpAppender">
                    <graylogHost>${graylogHost}</graylogHost>
                    <graylogPort>${graylogPort}</graylogPort>
                    <useCompression>true</useCompression>
                    <originHost>pos-service</originHost>
                    <facility>pos-service</facility>

                    <encoder class="de.siegmar.logbackgelf.GelfEncoder">
                        <originHost>pos-service</originHost>
                        <includeRawMessage>false</includeRawMessage>
                        <includeMdcKeyName>correlationId</includeMdcKeyName>
                    </encoder>
                </appender>

                <appender name="ASYNC_GELF_UDP" class="ch.qos.logback.classic.AsyncAppender">
                    <appender-ref ref="GELF_UDP"/>
                </appender>
            </then>
            <else>
                <!-- If graylog properties are missing, log a warning and do not start the GELF appender -->
                <logger name="de.siegmar.logbackgelf" level="WARN"/>
            </else>
        </if>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="graylog-enabled">
            <if condition='isDefined("graylogHost") &amp;&amp; isDefined("graylogPort")'>
                <then>
                    <appender-ref ref="ASYNC_GELF_UDP"/>
                </then>
            </if>
        </springProfile>
    </root>
</configuration>