# .env.example
# ==============================================================================
# SPRING BOOT CORE
# ==============================================================================
# For Local: local,graylog-enabled | For Docker: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=local,graylog-enabled
SERVER_PORT=28010
GRPC_PORT=29010

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

POSTGRES_DB=notification_service_db

# Local: localhost:5401 | Docker: db:5432
DATABASE_URL=jdbc:postgresql://localhost:5410/notification_service_db?currentSchema=notification_service&stringtype=unspecified&prepareThreshold=0&TimeZone=UTC

# Connection Pool
DB_POOL_MAX_SIZE=100
DB_POOL_MIN_IDLE=20
DB_REPLICA_POOL_MAX_SIZE=50
DB_REPLICA_POOL_MIN_IDLE=10

# ==============================================================================
# CACHE & DATA (Redis)
# ==============================================================================
SPRING_CACHE_TYPE=none
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=password
SPRING_DATA_REDIS_TIMEOUT=8000ms
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=20
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=10
SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=2

# ==============================================================================
# MESSAGING (Kafka)
# ==============================================================================
KAFKA_ENABLED=true
# Local: localhost:29092 | Docker: kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SPRING_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=

# ==============================================================================
# GRPC SERVICE DISCOVERY
# ==============================================================================
# Local: localhost | Docker: service-name (e.g. notification-service)
USER_GRPC_SERVICE=localhost:29001
RESTAURANT_GRPC_SERVICE=localhost:29002
MENU_GRPC_SERVICE=localhost:29003
BOOKING_GRPC_SERVICE=localhost:29004
ORDER_GRPC_SERVICE=localhost:29005
PAYMENT_GRPC_SERVICE=localhost:29006
POS_GRPC_SERVICE=localhost:29007
REVIEW_GRPC_SERVICE=localhost:29008
ANALYTICS_GRPC_SERVICE=localhost:29009
NOTIFICATION_GRPC_SERVICE=localhost:29010

GRPC_CLIENT_DEADLINE_SECONDS=60

# ==============================================================================
# TIMEOUTS (Optimized for High Scale/Large Files)
# ==============================================================================
CIRCUIT_BREAKER_TIMEOUT=305s

# ==============================================================================
# SPRINGDOC SWAGGER
# ==============================================================================
SWAGGER_API_GATEWAY_URL=http://localhost:8080/notification-docs

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Local: localhost:9411 | Docker: zipkin:9411
ZIPKIN_URL=http://localhost:9411/api/v2/spans
LOG_LEVEL=INFO

# Graylog
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=notification-service
GRAYLOG_FACILITY=notification-service
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_INCLUDE_CALLER_DATA=false
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# ==============================================================================
# SECURITY & ANTI-FRAUD
# ==============================================================================
BRUTEFORCE_WARNING_THRESHOLD=3
BRUTEFORCE_IP_BLOCK_THRESHOLD=5
BRUTEFORCE_PHONE_BLOCK_THRESHOLD=10
BRUTEFORCE_PERMANENT_BLOCK_THRESHOLD=15
BRUTEFORCE_IP_BLOCK_DURATION_MINUTES=15
BRUTEFORCE_PHONE_BLOCK_DURATION_MINUTES=60

ANTIFRAUD_MAX_DEVICES_PER_USER=3
ANTIFRAUD_MULTI_ACCOUNT_IP_THRESHOLD=3

# ==============================================================================
# CLOUD & OTHER
# ==============================================================================
CONNECTION_POOL_MONITORING_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_NAMESPACES=tuttime
SPRING_CLOUD_KUBERNETES_CONFIG_ENABLED=false

# ==============================================================================
# TWILIO SMS
# ==============================================================================
TWILIO_ACCOUNT_SID=twilio_account_sid
TWILIO_AUTH_TOKEN=***REMOVED***
TWILIO_PHONE_NUMBER=71234567890

# ==============================================================================
# MAIL SETTINGS
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
