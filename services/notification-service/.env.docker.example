# .env.docker
# ==============================================================================
# SPRING BOOT CORE
# ==============================================================================
# For Local: local,graylog-enabled | For Docker: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker,graylog-enabled
SERVER_PORT=28010
GRPC_PORT=29010

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

POSTGRES_DB=notification_service_db

# Local: localhost:5401 | Docker: db:5432
DATABASE_URL=jdbc:postgresql://notification-service-db:5432/notification_service_db?currentSchema=notification_service&stringtype=unspecified&prepareThreshold=0&TimeZone=UTC

# Connection Pool
DB_POOL_MAX_SIZE=100
DB_POOL_MIN_IDLE=20
DB_REPLICA_POOL_MAX_SIZE=50
DB_REPLICA_POOL_MIN_IDLE=10

# ==============================================================================
# SECURITY (CLUSTER INTERNAL SECRET)
# ==============================================================================
CLUSTER_INTERNAL_SECRET=***REMOVED***

# ==============================================================================
# REDIS OVERRIDE FLAGS - 🛑 SAFELY DEACTIVATED
# ==============================================================================
SPRING_CACHE_TYPE=none

# ==============================================================================
# MESSAGING (Kafka)
# ==============================================================================
KAFKA_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=tuttime-kafka:9093
SPRING_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-256
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG='org.apache.kafka.common.security.scram.ScramLoginModule required username="notification-kafka-user" password="***REMOVED***";'

# ==============================================================================
# SECURITY (JWT)
# ==============================================================================
JWT_SECRET=***REMOVED***
JWT_EXPIRATION=86400000
JWT_ISSUER=tuttime-backend
JWT_AUDIENCE=tuttime-frontend

# ==============================================================================
# GRPC SERVICE DISCOVERY
# ==============================================================================
# Local: localhost | Docker: service-name (e.g. user-service)
USER_GRPC_SERVICE=user-service:29001
RESTAURANT_GRPC_SERVICE=restaurant-service:29002
MENU_GRPC_SERVICE=menu-service:29003
BOOKING_GRPC_SERVICE=booking-service:29004
ORDER_GRPC_SERVICE=order-service:29005
PAYMENT_GRPC_SERVICE=payment-service:29006
POS_GRPC_SERVICE=pos-service:29007
REVIEW_GRPC_SERVICE=review-service:29008
ANALYTICS_GRPC_SERVICE=analytics-service:29009
NOTIFICATION_GRPC_SERVICE=notification-service:29010
GRPC_CLIENT_DEADLINE_SECONDS=60

# ==============================================================================
# TIMEOUTS (Optimized for High Scale/Large Files)
# ==============================================================================
CIRCUIT_BREAKER_TIMEOUT=305s

# ==============================================================================
# SPRINGDOC SWAGGER
# ==============================================================================
SWAGGER_API_GATEWAY_URL=http://localhost:8080/notification-docs

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Local: localhost:9411 | Docker: zipkin:9411
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans
LOG_LEVEL=INFO

# Graylog
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=notification-service
GRAYLOG_FACILITY=notification-service
GRAYLOG_INCLUDE_SOURCE=true
GRAYLOG_INCLUDE_MDC=true
GRAYLOG_INCLUDE_MARKER=true
GRAYLOG_INCLUDE_CALLER_DATA=false
GRAYLOG_MAX_MESSAGE_SIZE=8192
GRAYLOG_COMPRESSION_TYPE=GZIP

# ==============================================================================
# CLOUD & OTHER
# ==============================================================================
CONNECTION_POOL_MONITORING_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED=false
SPRING_CLOUD_KUBERNETES_DISCOVERY_NAMESPACES=tuttime
SPRING_CLOUD_KUBERNETES_CONFIG_ENABLED=false

# ==============================================================================
# TWILIO SMS
# ==============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=71234567890

# ==============================================================================
# MAIL SETTINGS
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-email-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
