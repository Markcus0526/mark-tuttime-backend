# ============================================================================
# Admin Service - Environment Variables Example
# Copy this file to .env.docker and update with your actual values
# ============================================================================

# Spring Profiles
# For Docker: docker
# To enable Graylog logging: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=local

# Database Configuration
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=admin_service_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ENABLED=true

# Zipkin Tracing Configuration
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# Service Name Variables (used for both REST and gRPC)
# Set to Docker service names for Docker environment
USER_SERVICE=user-service
MINING_SERVICE=mining-service
TOKEN_SERVICE=***REMOVED***
STAKING_SERVICE=staking-service
REWARDS_SERVICE=rewards-service
CONTENT_SERVICE=content-service
CONVERSION_SERVICE=conversion-service
NOTIFICATION_SERVICE=notification-service
ADMIN_SERVICE=admin-service

# gRPC Configuration
GRPC_PORT=29199

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600000
JWT_ISSUER=tuttime-admin-backend
JWT_AUDIENCE=tuttime-admin-panel

# Logging Configuration
LOG_LEVEL=INFO

# Graylog Configuration (optional - only used if graylog-enabled profile is active)
GRAYLOG_HOST=90.156.157.241
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=admin-service
GRAYLOG_FACILITY=admin-service

# S3 Configuration for Video Storage (if applicable)
APP_S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
APP_S3_REGION=ru-7
APP_S3_BUCKET=tuttime-storage
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_BASE_URL=
APP_S3_PRESIGNED_URL_EXPIRATION_HOURS=168

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.0.124:3000
