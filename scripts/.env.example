# Scripts Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Admin API Credentials
# Used by clear-admin-cache.sh and clear-admin-cache.ps1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Database Credentials
# Used by start-service.sh and other database-related scripts
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Docker Registry Credentials (for build-images scripts)
# Dev Container Registry: cr.selcloud.ru (login: token, password: your token)
DOCKER_REGISTRY=cr.selcloud.ru
DOCKER_PROJECT_PATH=your-project-path
DOCKER_USERNAME=token
DOCKER_PASSWORD=your_registry_token_here

# Admin Base URL (optional, defaults to http://localhost:28080)
# ADMIN_BASE_URL=http://localhost:28080
