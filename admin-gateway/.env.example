# ============================================================================
# Admin Gateway - Environment Variables Example
# Copy this file to .env.docker and update with your actual values
# ============================================================================

# Spring Profiles
# For Docker: docker
# To enable Graylog logging: docker,graylog-enabled
SPRING_PROFILES_ACTIVE=docker

# Redis Configuration
REDIS_HOST=tuttime-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Zipkin Tracing Configuration
ZIPKIN_URL=http://tuttime-zipkin:9411/api/v2/spans

# Service Name Variables (used for REST)
# Set to Docker service names for Docker environment
ADMIN_SERVICE=admin-service

# JWT Security Configuration
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_EXPIRATION=86400000

# Logging Configuration
LOG_LEVEL=INFO

# Graylog Configuration (optional - only used if graylog-enabled profile is active)
GRAYLOG_HOST=90.156.157.241
GRAYLOG_PORT=12203
GRAYLOG_ORIGIN_HOST=admin-gateway
GRAYLOG_FACILITY=admin-gateway

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://app.apart.com,http://localhost:3000,http://localhost:3001