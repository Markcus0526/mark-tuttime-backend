# .env.docker
# ==============================================================================
# TUTTIME GLOBAL INFRASTRUCTURE DEVELOPER CREDENTIALS
# ==============================================================================

# Redis Security Access Key
INFRA_REDIS_PASSWORD=password

# Graylog Logging Credentials
GRAYLOG_PASSWORD_SECRET=***REMOVED***
GRAYLOG_ROOT_PASSWORD_SHA2=***REMOVED***

# Kafka Microservice Account Matrix Lookups
KAFKA_USERS_LIST=gateway-kafka-user,user-kafka-user,restaurant-kafka-user,menu-kafka-user,booking-kafka-user,payment-kafka-user,order-kafka-user,pos-kafka-user,review-kafka-user,analytics-kafka-user,notification-kafka-user
KAFKA_PASSWORDS_LIST=***REMOVED***

# Password Kafka UI uses to log in as user-kafka-user (must match KAFKA_PASSWORDS_LIST)
KAFKA_UI_PASSWORD=***REMOVED***
