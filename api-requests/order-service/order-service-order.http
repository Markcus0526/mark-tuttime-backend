### ============================================
### ORDER SERVICE ENDPOINTS
### ============================================

@baseUrl = http://localhost:8080
@path = /api/v1/orders
@orderId = 1
@bookingId = 1
@userId = 1


### Create a new order
### Request Body: BookingDto
### Response: Created BookingDto
POST {{baseUrl}}{{path}}
#Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "bookingId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "userId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "status": "CREATED",
  "totalAmount": 0,
  "createdAt": "2026-03-25T11:48:00.173Z",
  "updatedAt": "2026-03-25T11:48:00.173Z",
  "orderItems": [
    {
      "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "menuItemId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "quantity": 0,
      "price": 0,
      "createdAt": "2026-03-25T11:48:00.173Z",
      "updatedAt": "2026-03-25T11:48:00.173Z",
      "modifiers": [
        {
          "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "modifierId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "priceAdjustment": 0,
          "createdAt": "2026-03-25T11:48:00.173Z",
          "updatedAt": "2026-03-25T11:48:00.173Z"
        }
      ]
    }
  ]
}

### Update order by ID
### Request Body: BookingDto
### Response: Updated BookingDto
PUT {{baseUrl}}{{path}}/{orderId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "CONFIRMED",
  "totalPrice": 120.00
}

### Get order by ID
### Request Body: -
### Response: BookingDto
GET {{baseUrl}}{{path}}/{orderId}
#Authorization: Bearer {{token}}
Content-Type: application/json

### Get orders by booking ID
### Request Body: -
### Response: List<BookingDto>
GET {{baseUrl}}{{path}}/booking/{{bookingId}}
#Authorization: Bearer {{token}}
Content-Type: application/json

### Get orders by user ID
### Request Body: -
### Response: List<BookingDto>
GET {{baseUrl}}{{path}}/user/{{userId}}
#Authorization: Bearer {{token}}
Content-Type: application/json

### Delete order by ID
### Request Body: -
### Response: No content (204)
DELETE {{baseUrl}}{{path}}/{{orderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

### Update order status by ID
### Request Body: -
### Response: No content (204)
PATCH {{baseUrl}}{{path}}/{{orderId}}/status?status=VALUE
Authorization: Bearer {{token}}
Content-Type: application/json
