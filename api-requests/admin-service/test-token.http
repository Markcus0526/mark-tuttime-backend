### Test Token Variable
### Run this after login to verify the token was saved correctly
GET http://localhost:28080/api/admin/system/config
Authorization: Bearer {{token}}

> {%
    const token = client.global.get("token");
    if (token) {
        client.log("✓ Token is set. Length: " + token.length);
        client.log("Token preview: " + token.substring(0, 50) + "...");
        client.log("Token ends with: ..." + token.substring(token.length - 20));
    } else {
        client.log("✗ ERROR: Token is NOT set!");
        client.log("Please run the login request first.");
    }
%}

