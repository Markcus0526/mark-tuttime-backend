### ============================================
### ADMIN SERVICE ENDPOINTS
### ============================================
### Base URL: http://localhost:28080/api/admin
### Requires: Admin authentication token

@adminBaseUrl = http://localhost:28080
@adminPath = /api/admin

### ============================================
### ADMIN AUTHENTICATION
### ============================================

### Admin Login
POST {{adminBaseUrl}}{{adminPath}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "***REMOVED***"
}

> {%
    if (response.status === 200 && response.body.data) {
        client.global.set("adminToken", response.body.data.token);
    }
%}

### Admin Logout
POST {{adminBaseUrl}}{{adminPath}}/auth/logout
Authorization: Bearer {{adminToken}}
Content-Type: application/json

### ============================================
### STATUS LEVELS
### ============================================

### Get All Status Levels
GET {{adminBaseUrl}}{{adminPath}}/status-levels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

### Create Status Level
POST {{adminBaseUrl}}{{adminPath}}/status-levels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "levelName": "PLATINUM",
  "minApartBalance": 200000.0,
  "apBoostPerHour": 5.0,
  "includesProAutoMining": true,
  "displayOrder": 3,
  "isActive": true
}

### Update Status Level
PUT {{adminBaseUrl}}{{adminPath}}/status-levels/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "levelName": "PLATINUM",
  "minApartBalance": 200000.0,
  "apBoostPerHour": 6.0,
  "includesProAutoMining": true,
  "displayOrder": 3,
  "isActive": true
}

### ============================================
### STAKING POOLS
### ============================================

### Create Staking Pool
POST {{adminBaseUrl}}{{adminPath}}/staking/pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Premium Pool",
  "apy": 15.5,
  "minStakeAmount": 1000.0,
  "maxStakeAmount": 100000.0,
  "lockPeriodDays": 30,
  "isActive": true
}

### Update Staking Pool
PUT {{adminBaseUrl}}{{adminPath}}/staking/pools/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Updated Premium Pool",
  "apy": 16.0,
  "minStakeAmount": 1000.0,
  "maxStakeAmount": 100000.0,
  "lockPeriodDays": 30,
  "isActive": true
}

### ============================================
### LANGUAGES
### ============================================

### Get All Languages
GET {{adminBaseUrl}}{{adminPath}}/languages
Authorization: Bearer {{adminToken}}
Content-Type: application/json

### ============================================
### SYSTEM CONFIG
### ============================================

### Get System Config
GET {{adminBaseUrl}}{{adminPath}}/system/config
Authorization: Bearer {{adminToken}}
Content-Type: application/json

### Update System Config
PUT {{adminBaseUrl}}{{adminPath}}/system/config
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "key": "mining.baseSpeed",
  "value": "1.0"
}

