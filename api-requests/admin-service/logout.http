### Logout Request
### Uses the token saved from login request
POST http://localhost:28080/api/admin/auth/logout
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    // Debug: Log the token being used
    const token = client.global.get("token");
    if (token) {
        client.log("Using token for logout. Length: " + token.length);
        client.log("Token preview: " + token.substring(0, 50) + "...");
    } else {
        client.log("ERROR: No token found! Please run login request first.");
    }
    
    // Clear token on successful logout
    if (response.status === 200) {
        let responseData;
        if (typeof response.body === 'string') {
            responseData = JSON.parse(response.body);
        } else {
            responseData = response.body;
        }
        
        if (responseData && responseData.success) {
            client.global.set("token", "");
            client.log("Logout successful. Token cleared.");
        }
    }
%}
