### Refresh Token
### This endpoint allows mobile apps to refresh their access token without requiring user login
### Use this when the access token expires (typically after 24 hours)

POST http://localhost:29000/api/v1/users/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  if (response.status === 200) {
    const responseBody = response.body;
    if (responseBody.success && responseBody.data) {
      client.global.set("token", responseBody.data.token);
      client.global.set("refreshToken", responseBody.data.refreshToken);
      client.log("✅ Token refreshed successfully!");
      client.log("New access token saved");
      client.log("New refresh token saved");
    }
  } else {
    client.log("❌ Token refresh failed: " + response.body.message);
  }
%}

